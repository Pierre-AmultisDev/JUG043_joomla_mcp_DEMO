# Kopieer dit bestand naar .env en vul echte wachtwoorden in:
#   cp .env.example .env
#
# LET OP: als je MYSQL_DATABASE of MCP_READER_PASSWORD hieronder wijzigt,
# pas dan OOK init/01-create-readonly-user.sql aan. Bestanden in
# docker-entrypoint-initdb.d ondersteunen geen variabele-substitutie vanuit
# dit .env-bestand, dus die twee moeten handmatig gelijk blijven.

MYSQL_ROOT_PASSWORD=change_me_root_pw
MYSQL_DATABASE=joomla
MYSQL_USER=joomla
MYSQL_PASSWORD=change_me_joomla_pw

MCP_READER_PASSWORD=change_me_reader_pw

# Joomla-tabelprefix van JOUW sitekopie (staat in configuration.php als
# $dbprefix). Vaak 'jos_', maar een moderne installatie gebruikt meestal een
# willekeurige prefix om veiligheidsredenen -- controleer dit!
DB_TABLE_PREFIX=jos_

# Voor de opencode-container. Standaard OpenCode Zen (gratis modellen).
# Key aanmaken op https://opencode.ai/auth (kan om betaalgegevens vragen,
# ook voor de gratis modellen -- zie opencode/README.md).
OPENCODE_API_KEY=

# Optioneel alternatief: Groq (gratis tier) -> https://console.groq.com/keys
GROQ_API_KEY=

# Optioneel: alleen invullen als je in opencode/opencode.json tijdelijk
# naar Claude wil wisselen i.p.v. het gratis Groq-model.
ANTHROPIC_API_KEY=

# Joomla! website administrator password
JOOMLA_ADMIN_PASSWORD=change_me_joomla_admin_pw

# 'db' (standaard, deze POC) of 'api' (Joomla Web Services API, voor later
# op een live site zonder directe DB-toegang). Zie code/py_app/config.py.
DATA_BACKEND=db

# Alleen invullen als DATA_BACKEND=api:
JOOMLA_API_BASE_URL=
JOOMLA_API_TOKEN=
